{
  "name": "icp-website-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:server\"",
    "dev:web": "pnpm --filter @icp/web run dev",
    "dev:server": "pnpm --filter @icp/server run dev",
    "build": "pnpm --filter @icp/web run build && pnpm --filter @icp/server run build",
    "build:web": "pnpm --filter @icp/web run build",
    "build:server": "pnpm --filter @icp/server run build"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
